# ==============================================================================
# Smart B2B Payment Recovery Platform - Configuration
# All external keys are optional: without them, system runs seamlessly in DEMO MODE
# ==============================================================================

# Database Configuration (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI / LLM Configuration (For grounded chat and drafting)
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-1.5-flash

# Meta WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-account-id

# Indian SMS Gateway (DLT Approved)
SMS_GATEWAY_URL=https://www.fast2sms.com/dev/bulkV2
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=RECVER
SMS_DLT_ENTITY_ID=110716182901

# Email Service (SMTP / SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=recoveries@yourbusiness.com

# AI Voice Telephony (Twilio / Exotel)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
EXOTEL_ACCOUNT_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-key
EXOTEL_API_TOKEN=your-exotel-token
EXOTEL_CALLER_ID=02269011234
